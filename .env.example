# Created by Vercel CLI
VERCEL_OIDC_TOKEN="<your_vercel_oidc_token>"
VITE_GROQ_API_KEY="gsk_<your_groq_api_key>"
VITE_SUPABASE_ANON_KEY="<your_supabase_anon_key>"
VITE_SUPABASE_URL="https://<your-project-ref>.supabase.co"

# Optional map-provider key. The current UI uses a provider-agnostic map preview;
# set this when replacing it with Mapbox or Google Maps.
VITE_MAPBOX_ACCESS_TOKEN="<your_mapbox_public_token>"

# Optional Google Places API key. When set, the location search uses Google Places
# Autocomplete for exact street/barangay matches (falling back to OpenStreetMap search
# when absent or offline). The map pin remains the manual fallback either way.
VITE_GOOGLE_MAPS_API_KEY="<your_google_maps_api_key>"

# ── Email Notifications (SERVER-SIDE — Vercel Function /api/send-email) ───────
# These are server-only environment variables. Set them in the Vercel project
# dashboard (Settings → Environment Variables) — NEVER as VITE_* and never in
# .env.local, or the secrets end up compiled into the public bundle.
#
# SendGrid API key: https://app.sendgrid.com/settings/api_keys
#   Requires "Mail Send" permission (Full Access or Restricted → Mail Send)
SENDGRID_API_KEY="SG.REPLACE_WITH_YOUR_SENDGRID_API_KEY"

# Verified sender address in your SendGrid account
# Must be verified at: https://app.sendgrid.com/settings/sender_auth
SENDGRID_FROM_EMAIL="noreply@yourdomain.com"
SENDGRID_FROM_NAME="MotoLink"

# Supabase URL + service-role key (server-side client the function uses to
# resolve appointment data and write the audit log). From the Supabase dashboard
# → Settings → API. NEVER expose the service key publicly.
# (In local dev via `vercel dev`, the function falls back to VITE_SUPABASE_URL
#  when SUPABASE_URL is not set — the service-role key has no fallback.)
SUPABASE_URL="https://<your-project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<your_supabase_service_role_key>"

# ── Online Payments (SERVER-SIDE — Vercel Functions) ─────────────────────────
# Server-only. Set these in the Vercel project dashboard, NEVER as VITE_* and
# never in .env.local, or the secrets get bundled into the public client.
#
# PayMongo secret key (sk_live_... / sk_test_...). From:
#   https://dashboard.paymongo.com/developers
# Powers /api/create-payment (GCash / Maya reservation deposits).
PAYMONGO_SECRET_KEY="sk_test_REPLACE_WITH_YOUR_PAYMONGO_SECRET_KEY"

# PayMongo webhook signing secret for the /api/payment-webhook endpoint.
# Create the webhook in the PayMongo dashboard pointing at
#   https://<your-domain>/api/payment-webhook
# and subscribe to: payment.paid, payment.failed, payment_intent.succeeded,
# payment_intent.cancelled, payment.expired. Copy its secret here.
# If unset the webhook skips signature verification (dev/test only) and logs a
# warning — always set it in production.
PAYMONGO_WEBHOOK_SECRET="whsk_REPLACE_WITH_YOUR_PAYMONGO_WEBHOOK_SECRET"

# ── Shop Retention (SERVER-SIDE — cron + purge) ──────────────────────────────
# Server-only. Set these in the Vercel project dashboard, NEVER as VITE_* and
# never in .env.local.
#
# Random 32-byte key (generate with: openssl rand -base64 32). Used to encrypt
# each shop's export (AES-256-GCM) before it is stored. The purge job refuses
# to run without it — no data is ever anonymized without a backup.
EXPORT_ENCRYPTION_KEY="REPLACE_WITH_BASE64_32_BYTE_KEY"

# Supabase Storage bucket for encrypted shop exports (auto-created on purge if
# missing via the /retention/… prefix is not required — create it in the
# dashboard: Storage → New bucket → Private).
STORAGE_BUCKET="shop-exports"

# Shared secret that gates the cron endpoints /api/shop-purge and
# /api/shop-reminders. The GitHub Action "Shop retention" workflow sends this in
# the `x-cron-secret` header. Must match the GitHub Actions secret CRON_SECRET.
CRON_SECRET="REPLACE_WITH_A_LONG_RANDOM_STRING"

# The retention window (days) default is 45. Admins can change it at runtime via
# the Admin Platform Settings (`shop_retention_days` in platform_settings) — no
# deploy or env var needed.
