# Created by Vercel CLI
VERCEL_OIDC_TOKEN="<your_vercel_oidc_token>"
VITE_GROQ_API_KEY="gsk_<your_groq_api_key>"
VITE_SUPABASE_ANON_KEY="<your_supabase_anon_key>"
VITE_SUPABASE_URL="https://<your-project-ref>.supabase.co"

# Optional map-provider key. The current UI uses a provider-agnostic map preview;
# set this when replacing it with Mapbox or Google Maps.
VITE_MAPBOX_ACCESS_TOKEN="<your_mapbox_public_token>"

# Optional Google Places API key. When set, the location search uses Google Places
# Autocomplete for exact street/barangay matches (falling back to OpenStreetMap search
# when absent or offline). The map pin remains the manual fallback either way.
VITE_GOOGLE_MAPS_API_KEY="<your_google_maps_api_key>"

# ── Email Notifications (SERVER-SIDE — Vercel Function /api/send-email) ───────
# These are server-only environment variables. Set them in the Vercel project
# dashboard (Settings → Environment Variables) — NEVER as VITE_* and never in
# .env.local, or the secrets end up compiled into the public bundle.
#
# SendGrid API key: https://app.sendgrid.com/settings/api_keys
#   Requires "Mail Send" permission (Full Access or Restricted → Mail Send)
SENDGRID_API_KEY="SG.REPLACE_WITH_YOUR_SENDGRID_API_KEY"

# Verified sender address in your SendGrid account
# Must be verified at: https://app.sendgrid.com/settings/sender_auth
SENDGRID_FROM_EMAIL="noreply@yourdomain.com"
SENDGRID_FROM_NAME="MotoLink"

# Supabase URL + service-role key (server-side client the function uses to
# resolve appointment data and write the audit log). From the Supabase dashboard
# → Settings → API. NEVER expose the service key publicly.
SUPABASE_SERVICE_ROLE_KEY="<your_supabase_service_role_key>"
